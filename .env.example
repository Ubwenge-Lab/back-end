# backend/.env.example

# ========================================
# APPLICATION
# ========================================
NODE_ENV=development
PORT=4000

# ========================================
# DATABASE
# ========================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/evuze_pharmacy?schema=public"

# ========================================
# JWT SECRETS
# ========================================
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ========================================
# SUPER ADMIN CREDENTIALS (for seed)
# ========================================
SUPER_ADMIN_EMAIL="admin@evuze.rw"
SUPER_ADMIN_PASSWORD="SuperAdmin@2025"

# ========================================
# SUPER ADMIN SECRET KEY (for login)
# ========================================
SUPER_ADMIN_SECRET_KEY="your-super-secret-admin-key-2025"

# ========================================
# SENDGRID (Email Notifications)
# ========================================
SENDGRID_API_KEY="SG.your-sendgrid-api-key"
SENDGRID_FROM_EMAIL="noreply@evuze.rw"
SENDGRID_FROM_NAME="E-Vuze Healthcare"

# ========================================
# FLUTTERWAVE (Payment Gateway)
# ========================================
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-your-public-key"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-your-secret-key"
FLUTTERWAVE_ENCRYPTION_KEY="FLWSECK_TESTyour-encryption-key"
FLUTTERWAVE_WEBHOOK_SECRET="your-webhook-secret"

# Test Mode (true for sandbox, false for production)
FLUTTERWAVE_TEST_MODE=true

# ========================================
# AWS S3 (File Storage)
# ========================================
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_BUCKET="evuze-pharmacy-files"

# ========================================
# FRONTEND URL (for CORS)
# ========================================
FRONTEND_URL="http://localhost:3000"

# ========================================
# REDIS (Optional - for caching)
# ========================================
REDIS_URL="redis://localhost:6379"

# ========================================
# INSURANCE PROVIDERS (Mock for MVP)
# ========================================
# Comma-separated list of insurance providers
INSURANCE_PROVIDERS="MMI,RSSB,Sanlam,RAMA,Britam,Radiant"