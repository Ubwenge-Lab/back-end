# backend/.env.example

# ========================================
# APPLICATION
# ========================================
NODE_ENV=production
PORT=4000

# ========================================
# DATABASE
# ========================================
DATABASE_URL=

# ========================================
# JWT SECRETS
# ========================================
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ========================================
# FIELD/FILE ENCRYPTION (AES-256)
# ========================================
# Used by src/common/utils/encryption.util.ts to encrypt clinical fields
# (Patient.mrn/phone/nationalId, etc.) and lab result files at rest.
# Must be exactly 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# If this is unset in any environment (including production), encryption.util.ts
# silently falls back to a hardcoded key in source — set this explicitly everywhere.
ENCRYPTION_KEY=""

# ========================================
# SUPER ADMIN CREDENTIALS
# ========================================
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_SECRET_KEY=""

# ========================================
# RESEND (Email)
# ========================================
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM_EMAIL=""
RESEND_FROM_NAME=""

# ========================================
# FLUTTERWAVE (Payments)
# ========================================
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-your-public-key"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-your-secret-key"
FLUTTERWAVE_ENCRYPTION_KEY="FLWSECK_TESTyour-encryption-key"
FLUTTERWAVE_WEBHOOK_SECRET="your-webhook-secret"
FLUTTERWAVE_TEST_MODE=true

# ========================================
# FILE STORAGE
# ========================================
# Files (licenses, prescriptions, medication images) are stored directly in
# PostgreSQL as base64 data URIs. No AWS S3 or any third-party storage needed.
# The existing String fields in the schema hold the data URI directly.
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_S3_BUCKET are NOT required.

# ========================================
# FRONTEND URL (CORS)
# ========================================
FRONTEND_URL="https://e-vuze-testing.vercel.app/"

# ========================================
# REDIS (Optional)
# ========================================
REDIS_URL="redis://localhost:6379"

# ========================================
# INSURANCE PROVIDERS
# ========================================
INSURANCE_PROVIDERS="MMI,RSSB,Sanlam,RAMA,Britam,Radiant"
