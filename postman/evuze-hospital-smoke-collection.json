  "item": [
    {
      "name": "Setup / Login",
      "description": "Logs in as each fixture actor and stores the access token as a collection variable for the requests that follow. Fixture users must already exist in the target environment (TEST_SMOKE_ prefix, same as the Jest suite's beforeAll).",
      "item": [
        {
          "name": "Login - Doctor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{doctorEmail}}\",\n  \"password\": \"{{doctorPassword}}\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login - Doctor - status 200/201', function () {",
                  "    pm.expect([200,201]).to.include(pm.response.code);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Login - Doctor - accessToken present', function () {",
                  "    pm.expect(data.accessToken).to.be.a('string');",
                  "});",
                  "if (data.accessToken) { pm.collectionVariables.set('doctorToken', data.accessToken); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
