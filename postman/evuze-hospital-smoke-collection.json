    {
      "name": "0. Booking",
      "item": [
        {
          "name": "Patient books an appointment with the doctor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/appointments/book",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments",
                "book"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"date\": \"{{$isoTimestamp}}\",\n  \"reason\": \"Smoke test consultation\",\n  \"type\": \"IN_PERSON\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.test('appointment.id is defined', function () { pm.expect(data.appointment).to.have.property('id'); });",
                  "pm.test('appointment.status is SCHEDULED', function () { pm.expect(data.appointment.status).to.eql('SCHEDULED'); });",
                  "if (data.appointment && data.appointment.id) { pm.collectionVariables.set('appointmentId', data.appointment.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Queue (Check-in)",
      "item": [
        {
          "name": "Receptionist checks the patient in (SCHEDULED -> ARRIVED)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{receptionistToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/appointments/{{appointmentId}}/check-in",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments",
                "{{appointmentId}}",
                "check-in"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('status is ARRIVED', function () { pm.expect(data.status).to.eql('ARRIVED'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Second check-in attempt is rejected (status guard)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{receptionistToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/appointments/{{appointmentId}}/check-in",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments",
                "{{appointmentId}}",
                "check-in"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 409 - already checked in', function () { pm.response.to.have.status(409); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Nurse records triage vitals (ARRIVED -> READY_FOR_DOCTOR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{nurseToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/appointments/{{appointmentId}}/triage",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments",
                "{{appointmentId}}",
                "triage"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bloodPressure\": \"120/80\",\n  \"temperature\": 37.1,\n  \"weight\": 68,\n  \"heartRate\": 76,\n  \"oxygenSaturation\": 98,\n  \"notes\": \"Patient alert and oriented\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.test('status is READY_FOR_DOCTOR', function () { pm.expect(data.status).to.eql('READY_FOR_DOCTOR'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Consultation",
      "item": [
        {
          "name": "Doctor completes the consult and an invoice is generated",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{doctorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/appointments/{{appointmentId}}/consult",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments",
                "{{appointmentId}}",
                "consult"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"diagnosisSummary\": \"Acute pharyngitis\",\n  \"doctorRecommendations\": \"Rest, fluids, review in 5 days\",\n  \"items\": [\n    {\n      \"description\": \"Consultation fee\",\n      \"quantity\": 1,\n      \"unitCost\": 5000\n    },\n    {\n      \"description\": \"Triage fee\",\n      \"quantity\": 1,\n      \"unitCost\": 2000\n    }\n  ]\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('invoice.id is defined', function () { pm.expect(data.invoice).to.have.property('id'); });",
                  "pm.test('invoice.totalAmount is 7000', function () { pm.expect(Number(data.invoice.totalAmount)).to.eql(7000); });",
                  "pm.test('invoice.paymentStatus is UNPAID', function () { pm.expect(data.invoice.paymentStatus).to.eql('UNPAID'); });",
                  "if (data.invoice && data.invoice.id) { pm.collectionVariables.set('hospitalInvoiceId', data.invoice.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Labs",
      "item": [
        {
          "name": "Doctor requests a diagnostic order tied to the appointment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{doctorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/diagnostics/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "diagnostics",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"appointmentId\": \"{{appointmentId}}\",\n  \"testType\": \"BLOOD\",\n  \"icd10Code\": \"J02.9\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.test('id is defined', function () { pm.expect(data).to.have.property('id'); });",
                  "pm.test('status is PENDING', function () { pm.expect(data.status).to.eql('PENDING'); });",
                  "if (data.id) { pm.collectionVariables.set('labOrderId', data.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Order appears in the technician queue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{technicianToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/diagnostics/queue?status=PENDING",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "diagnostics",
                "queue"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "const labOrderId = pm.collectionVariables.get('labOrderId');",
                  "const ids = data.map(function (o) { return o.id; });",
                  "pm.test('labOrderId is in the queue', function () { pm.expect(ids).to.include(labOrderId); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Technician reports findings and marks the order COMPLETED",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{technicianToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/diagnostics/orders/{{labOrderId}}/findings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "diagnostics",
                "orders",
                "{{labOrderId}}",
                "findings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\",\n  \"findings\": \"No abnormalities detected\",\n  \"resultValue\": \"WBC 6.2 x10^9/L\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('status is COMPLETED', function () { pm.expect(data.status).to.eql('COMPLETED'); });",
                  "pm.test('completedAt is defined', function () { pm.expect(data.completedAt).to.not.be.undefined; });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Billing",
      "item": [
        {
          "name": "Settles the hospital invoice via the payment webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/webhook/hospital",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "webhook",
                "hospital"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceId\": \"{{hospitalInvoiceId}}\",\n  \"status\": \"SUCCESSFUL\",\n  \"transactionRef\": \"TEST-SMOKE-TXN-001\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.test(\"response status is 'success'\", function () { pm.expect(data.status).to.eql('success'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Pharmacy Checkout",
      "item": [
        {
          "name": "Patient checks out an order for pickup, paying CASH",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
