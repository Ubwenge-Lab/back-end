// backend/prisma/schema.prisma
// Updated schema with AI prescription features

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


// ========================================
// ENUMS
// ========================================

enum UserRole {
  SUPER_ADMIN
  PHARMACY
  PATIENT
}

enum PharmacyStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  OUT_FOR_DELIVERY
  READY_FOR_PICKUP
  DELIVERED
  COMPLETED
  CANCELLED
}

enum OrderType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  MTN_MOMO
  AIRTEL_MONEY
  CARD
  INSURANCE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  ORDER_PLACED
  ORDER_ACCEPTED
  ORDER_PREPARING
  ORDER_OUT_FOR_DELIVERY
  ORDER_READY_FOR_PICKUP
  ORDER_DELIVERED
  ORDER_CANCELLED
  PRESCRIPTION_REJECTED
  PRESCRIPTION_APPROVED
  PHARMACY_APPROVED
  PHARMACY_REJECTED
}

enum PrescriptionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AIProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ========================================
// MODELS
// ========================================

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  password              String
  role                  UserRole
  isVerified            Boolean   @default(false)
  
  verificationCode      String?
  verificationCodeExpiry DateTime?
  
  refreshToken          String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  patient               Patient?
  pharmacy              Pharmacy?

  @@index([email])
  @@map("users")
}

model Patient {
  id            String    @id @default(uuid())
  userId        String    @unique
  firstName     String
  lastName      String
  phone         String
  dateOfBirth   DateTime?
  gender        String?
  address       String?
  
  insuranceProvider String?
  insurancePolicy   String?
  insuranceMemberId String?
  insuranceCoverage Int?    @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]
  prescriptions Prescription[]
  notifications Notification[]
  cartItems     CartItem[]

  @@index([userId])
  @@map("patients")
}

model Pharmacy {
  id                  String          @id @default(uuid())
  userId              String          @unique
  
  name                String
  representativeName  String
  phone               String
  address             String
  latitude            Float?
  longitude           Float?
  
  dateOfIncorporation DateTime
  rdbCertificate      String
  pharmacyLicense     String
  
  deliveryZones       Json?
  operatingHours      Json?
  
  status              PharmacyStatus  @default(PENDING)
  rejectionReason     String?         @db.Text
  
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  approvedAt          DateTime?

  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  medications         Medication[]
  orders              Order[]
  notifications       Notification[]
  cartItems           CartItem[]

  @@index([userId])
  @@index([status])
  @@map("pharmacies")
}

model Medication {
  id                    String    @id @default(uuid())
  pharmacyId            String
  name                  String
  description           String?   @db.Text
  category              String
  price                 Float
  quantity              Int
  lowStockThreshold     Int       @default(10)
  requiresPrescription  Boolean   @default(false)
  imageUrl              String?
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  pharmacy              Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  orderItems            OrderItem[]
  prescriptionMedications PrescriptionMedication[]
  cartItems             CartItem[]

  @@index([pharmacyId])
  @@index([name])
  @@map("medications")
}

model Order {
  id                String        @id @default(uuid())
  patientId         String
  pharmacyId        String
  
  orderNumber       String        @unique
  type              OrderType
  status            OrderStatus   @default(PENDING)
  
  deliveryAddress   String?
  deliveryFee       Float         @default(0)
  deliveryZone      String?
  
  prescriptionId    String?       @unique
  
  subtotal          Float
  total             Float
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(PENDING)
  insuranceCoverage Float?
  patientPayment    Float
  
  cancellationReason String?      @db.Text
  cancelledAt       DateTime?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  patient           Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pharmacy          Pharmacy      @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  prescription      Prescription? @relation(fields: [prescriptionId], references: [id])
  orderItems        OrderItem[]
  payment           Payment?
  notifications     Notification[]

  @@index([patientId])
  @@index([pharmacyId])
  @@index([orderNumber])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id            String      @id @default(uuid())
  orderId       String
  medicationId  String
  quantity      Int
  price         Float
  
  createdAt     DateTime    @default(now())

  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medication    Medication  @relation(fields: [medicationId], references: [id])

  @@index([orderId])
  @@index([medicationId])
  @@map("order_items")
}

model Prescription {
  id                    String                    @id @default(uuid())
  patientId             String
  fileUrl               String
  fileName              String
  fileType              String
  
  status                PrescriptionStatus        @default(PENDING)
  rejectionReason       String?                   @db.Text
  reviewedAt            DateTime?
  
  aiProcessingStatus    AIProcessingStatus?       @default(PENDING)
  aiProcessingError     String?                   @db.Text
  extractedMedications  Json?
  
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  patient               Patient                   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  order                 Order?
  prescriptionMedications PrescriptionMedication[]
  cartItems             CartItem[]

  @@index([patientId])
  @@index([status])
  @@map("prescriptions")
}

model PrescriptionMedication {
  id                   String        @id @default(uuid())
  prescriptionId       String
  medicationName       String
  dosage               String?
  frequency            String?
  duration             String?
  quantity             Int           @default(1)
  matchedMedicationId  String?
  available            Boolean       @default(false)
  createdAt            DateTime      @default(now())
  
  prescription         Prescription  @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  matchedMedication    Medication?   @relation(fields: [matchedMedicationId], references: [id], onDelete: SetNull)
  
  @@index([prescriptionId])
  @@index([matchedMedicationId])
  @@map("prescription_medications")
}

model CartItem {
  id              String        @id @default(uuid())
  patientId       String
  pharmacyId      String
  medicationId    String
  quantity        Int           @default(1)
  prescriptionId  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pharmacy        Pharmacy      @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medication      Medication    @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  prescription    Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  
  @@unique([patientId, medicationId])
  @@index([patientId])
  @@index([pharmacyId])
  @@index([medicationId])
  @@map("cart_items")
}

model Payment {
  id                  String        @id @default(uuid())
  orderId             String        @unique
  
  amount              Float
  paymentMethod       PaymentMethod
  status              PaymentStatus @default(PENDING)
  
  transactionId       String?       @unique
  flutterwaveRef      String?       @unique
  
  insuranceProvider   String?
  insurancePolicyNumber String?
  insuranceCoverage   Float?
  insuranceVerified   Boolean       @default(false)
  
  paymentResponse     Json?
  
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  order               Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([transactionId])
  @@map("payments")
}

model Notification {
  id          String            @id @default(uuid())
  userId      String?
  patientId   String?
  pharmacyId  String?
  orderId     String?
  
  type        NotificationType
  title       String
  message     String            @db.Text
  isRead      Boolean           @default(false)
  
  createdAt   DateTime          @default(now())

  patient     Patient?          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pharmacy    Pharmacy?         @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  order       Order?            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([pharmacyId])
  @@index([orderId])
  @@index([isRead])
  @@map("notifications")
}
