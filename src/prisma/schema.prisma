generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String          @id @default(uuid())
  email                  String          @unique
  password               String
  role                   UserRole
  isVerified             Boolean         @default(false)
  verificationCode       String?
  verificationCodeExpiry DateTime?
  refreshToken           String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  isActive               Boolean         @default(true)
  firstName              String?
  lastName               String?
  managedBranch          Branch?         @relation("BranchManager")
  doctor                 Doctor?
  hospitalStaff          HospitalStaff?
  hospital               Hospital?       @relation("HospitalOwner")
  patient                Patient?
  pharmacy               Pharmacy?       @relation("PharmacyOwner")
  staff                  Staff?
  SupportTickets         SupportTicket[]
  sentMessages           ChatMessage[]   @relation("SentMessages")
  receivedMessages       ChatMessage[]   @relation("ReceivedMessages")

  @@index([email])
  @@map("users")
}

model Hospital {
  id                          String                        @id @default(uuid())
  userId                      String                        @unique
  user                        User                          @relation("HospitalOwner", fields: [userId], references: [id])
  name                        String
  representativeName          String?
  address                     String
  phone                       String
  latitude                    Float?
  longitude                   Float?
  dateOfIncorporation         DateTime?
  rdbCertificate              String?
  pharmacyLicense             String?
  businessRegistration        String?
  status                      PharmacyStatus                @default(PENDING)
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  licenseNumber               String?
  platformBalance             Decimal                       @default(0) @db.Decimal(12, 2)
  appointments                Appointment[]
  doctors                     Doctor[]
  config                      HospitalConfig?
  drugStock                   HospitalDrugStock[]
  consumableStock             HospitalConsumableStock[]
  hospitalInvoices            HospitalInvoice[]
  hospitalRegistrations       HospitalPatientRegistration[]
  staff                       HospitalStaff[]
  invoices                    Invoice[]
  platformSubscriptionCharges PlatformSubscriptionCharge[]
  prescriptions               Prescription[]
  admissions                  InpatientAdmission[]
  referralWebhookUrl          String?
  referralWebhookSecret       String?
  outboundReferrals           Referral[]                    @relation("ReferralSource")
  inboundReferrals            Referral[]                    @relation("ReferralTarget")
  wards                       Ward[]
  operatingTheaters           OperatingTheater[]
  surgeryBookings             SurgeryBooking[]

  @@index([userId])
  @@map("hospitals")
}

model Doctor {
  id                     String                   @id @default(uuid())
  userId                 String                   @unique
  hospitalId             String
  specialization         String
  licenseNumber          String                   @unique
  bio                    String?
  createdAt              DateTime                 @default(now())
  isAvailable            Boolean                  @default(true)
  rating                 Float                    @default(0)
  updatedAt              DateTime                 @updatedAt
  firstName              String?
  lastName               String?
  signatureUrl           String?
  isDepartmentHead       Boolean                  @default(false)
  appointments           Appointment[]
  leaveRequests          DoctorLeave[]
  schedules              DoctorSchedule[]
  hospital               Hospital                 @relation(fields: [hospitalId], references: [id])
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicalHistoryAccesses MedicalHistoryAccess[]
  medicalRecordLogs      MedicalRecordLog[]
  authorizedReferrals    Referral[]
  diagnosticOrders       DiagnosticOrder[]
  inpatientAdmissions    InpatientAdmission[]
  prescriptions          Prescription[]           @relation("DoctorToPrescription")
  surgeryAssignments     SurgicalTeamAssignment[]

  @@index([hospitalId])
  @@index([specialization])
  @@map("doctors")
}

model DoctorSchedule {
  id        String @id @default(uuid())
  doctorId  String
  dayOfWeek Int
  startTime String
  endTime   String
  doctor    Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek, startTime])
  @@map("doctor_schedules")
}

model DoctorLeave {
  id               String      @id @default(uuid())
  doctorId         String
  startDate        DateTime
  endDate          DateTime
  reason           String
  status           LeaveStatus @default(PENDING)
  affectedPatients Int         @default(0)
  rejectionReason  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  doctor           Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([status])
  @@map("doctor_leaves")
}

model HospitalStaff {
  id                 String                   @id @default(uuid())
  userId             String                   @unique
  hospitalId         String
  firstName          String
  lastName           String
  phone              String?
  department         String?
  technicianSpecialization TechnicianSpecialization?
  status             StaffStatus              @default(ACTIVE)
  tempPasswordHash   String?
  tempPasswordExpiry DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  hospital           Hospital                 @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user               User                     @relation(fields: [userId], references: [id])
  vitalsRecorded     InpatientVitals[]        @relation("VitalsNurse")
  marAdministered    MARLog[]                 @relation("MARNurse")
  handoversGiven     NursingHandover[]        @relation("HandoverOutgoing")
  handoversReceived  NursingHandover[]        @relation("HandoverIncoming")
  surgeryAssignments SurgicalTeamAssignment[]

  @@index([hospitalId])
  @@index([userId])
  @@map("hospital_staff")
}

model Patient {
  id                     String                        @id @default(uuid())
  userId                 String                        @unique
  firstName              String
  lastName               String
  phone                  String
  dateOfBirth            DateTime?
  gender                 String?
  address                String?
  nationalId             String?
  insuranceProvider      String?
  insurancePolicy        String?
  insuranceMemberId      String?
  insuranceCoverage      Int?                          @default(0)
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  lastLat                Float?
  lastLng                Float?
  mrn                    String?
  appointments           Appointment[]
  cartItems              CartItem[]
  hospitalInvoices       HospitalInvoice[]
  hospitalRegistrations  HospitalPatientRegistration[]
  hospitalPayments       HospitalPayment[]
  invoices               Invoice[]
  medicalHistoryAccesses MedicalHistoryAccess[]
  medicalRecordLogs      MedicalRecordLog[]
  notifications          Notification[]
  orders                 Order[]
  user                   User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescriptions          Prescription[]
  admissions             InpatientAdmission[]
  referrals              Referral[]
  diagnosticOrders       DiagnosticOrder[]
  surgeryBookings        SurgeryBooking[]

  @@index([userId])
  @@map("patients")
}

model HospitalPatientRegistration {
  id           String   @id @default(uuid())
  patientId    String
  hospitalId   String
  mrn          String
  registeredAt DateTime @default(now())
  hospital     Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, hospitalId])
  @@unique([hospitalId, mrn])
  @@index([patientId])
  @@index([hospitalId])
  @@map("hospital_patient_registrations")
}

model Pharmacy {
  id                   String         @id @default(uuid())
  userId               String         @unique
  name                 String
  representativeName   String?
  phone                String
  address              String
  latitude             Float?
  longitude            Float?
  dateOfIncorporation  DateTime?
  rdbCertificate       String?
  pharmacyLicense      String?
  businessRegistration String?
  operatingHours       Json?
  status               PharmacyStatus @default(PENDING)
  rejectionReason      String?
  approvedAt           DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  isLocationVerified   Boolean        @default(false)
  locationVerifiedAt   DateTime?
  isActive             Boolean        @default(true)
  logoUrl              String?
  branches             Branch[]
  cartItems            CartItem[]
  medications          Medication[]
  notifications        Notification[]
  orders               Order[]
  user                 User           @relation("PharmacyOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pharmacies")
}

model Branch {
  id                 String          @id @default(uuid())
  pharmacyId         String
  managerId          String?         @unique
  name               String
  address            String
  phone              String
  latitude           Float?
  longitude          Float?
  isActive           Boolean         @default(true)
  operatingHours     Json?
  branchStatus       BranchStatus    @default(INVITED)
  branchManagerEmail String?
  pharmacyLicense    String?
  tempPasswordHash   String?
  tempPasswordExpiry DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  isLocationVerified Boolean         @default(false)
  locationVerifiedAt DateTime?
  branchManagerName  String?
  licenseUrl         String?
  status             BranchStatus    @default(INVITED)
  attendance         Attendance[]
  manager            User?           @relation("BranchManager", fields: [managerId], references: [id])
  pharmacy           Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medications        Medication[]
  orders             Order[]
  staff              Staff[]
  transfersFrom      StockTransfer[] @relation("FromBranch")
  transfersTo        StockTransfer[] @relation("ToBranch")

  @@index([pharmacyId])
  @@map("branches")
}

model Staff {
  id                 String            @id @default(uuid())
  userId             String            @unique
  branchId           String
  firstName          String
  lastName           String
  phone              String?
  nationalId         String?           @unique
  gender             String?
  dateOfBirth        DateTime?
  status             StaffStatus       @default(ACTIVE)
  workingHours       Json?
  tempPasswordHash   String?
  tempPasswordExpiry DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  address            String?
  clockInApprover    Attendance[]      @relation("ClockInApprover")
  clockOutApprover   Attendance[]      @relation("ClockOutApprover")
  attendances        Attendance[]
  branch             Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions        StaffPermissions?

  @@index([branchId])
  @@map("staff")
}

model StaffPermissions {
  id          String   @id @default(uuid())
  staffId     String   @unique
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("staff_permissions")
}

model MedicationRegistry {
  id                  String              @id @default(uuid())
  registrationNumber  String              @unique
  brandName           String
  genericName         String
  dosageStrength      String
  dosageForm          String
  packSize            String
  packagingType       String
  shelfLife           String
  manufacturerName    String
  manufacturerAddress String
  manufacturerCountry String
  marketingAuthHolder String?
  localTechRep        String?
  registrationDate    DateTime
  expiryDate          DateTime?
  hospitalDrugStock   HospitalDrugStock[]
  medications         Medication[]

  @@index([brandName])
  @@index([genericName])
  @@index([registrationNumber])
  @@map("medication_registry")
}

model Medication {
  id                      String                   @id @default(uuid())
  pharmacyId              String?
  branchId                String
  name                    String
  chemicalName            String?
  description             String?
  category                String?
  price                   Float
  quantity                Int                      @default(0)
  lowStockThreshold       Int                      @default(10)
  requiresPrescription    Boolean                  @default(false)
  imageUrl                String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  registryId              String?
  batchNumber             String?
  expiryDate              DateTime?
  manufacturer            String?
  cartItems               CartItem[]
  branch                  Branch                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  pharmacy                Pharmacy?                @relation(fields: [pharmacyId], references: [id])
  registry                MedicationRegistry?      @relation(fields: [registryId], references: [id])
  orderItems              OrderItem[]
  prescriptionMedications PrescriptionMedication[]
  transferItems           StockTransferItem[]

  @@index([branchId])
  @@index([pharmacyId, quantity])
  @@index([branchId, quantity])
  @@map("medications")
}

model HospitalDrugStock {
  hospitalId              String
  quantity                Int                      @default(0)
  unitPrice               Decimal                  @db.Decimal(12, 2)
  expiryDate              DateTime
  drugId                  String
  lastUpdated             DateTime                 @default(now()) @updatedAt
  reorderLevel            Int                      @default(10)
  drug                    MedicationRegistry       @relation(fields: [drugId], references: [id], onDelete: Cascade)
  hospital                Hospital                 @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  prescriptionMedications PrescriptionMedication[]

  @@id([drugId, hospitalId])
  @@index([hospitalId])
  @@map("hospital_drug_stock")
}

model Invoice {
  id            String            @id @default(uuid())
  hospitalId    String
  patientId     String
  totalAmount   Decimal           @db.Decimal(12, 2)
  status        InvoiceStatus     @default(UNPAID)
  dueDate       DateTime
  createdAt     DateTime          @default(now())
  appointmentId String?           @unique
  payments      HospitalPayment[]
  items         InvoiceItem[]
  appointment   Appointment?      @relation(fields: [appointmentId], references: [id])
  hospital      Hospital          @relation(fields: [hospitalId], references: [id])
  patient       Patient           @relation(fields: [patientId], references: [id])

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Appointment {
  id                    String                   @id @default(uuid())
  patientId             String
  doctorId              String
  hospitalId            String
  reason                String?
  status                AppointmentStatus        @default(SCHEDULED)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  date                  DateTime
  notes                 String?
  diagnosisSummary      String?
  doctorRecommendations String?
  telemedicineDuration  Int?
  type                  AppointmentType          @default(IN_PERSON)
  doctor                Doctor                   @relation(fields: [doctorId], references: [id])
  hospital              Hospital                 @relation(fields: [hospitalId], references: [id])
  patient               Patient                  @relation(fields: [patientId], references: [id])
  hospitalInvoice       HospitalInvoice?
  invoice               Invoice?
  prescriptions         Prescription[]
  sessionLogs           TelemedicineSessionLog[]
  diagnosticOrders      DiagnosticOrder[]
  triageVitals          TriageVitals?
  chatMessages          ChatMessage[]

  @@index([patientId])
  @@index([hospitalId])
  @@index([doctorId])
  @@map("appointments")
}

model TriageVitals {
  id               String      @id @default(uuid())
  appointmentId    String      @unique
  bloodPressure    String
  temperature      Float
  weight           Float
  heartRate        Int
  oxygenSaturation Int
  nurseNotes       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  appointment      Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("triagevitals")
}

model Prescription {
  id                      String                   @id @default(uuid())
  patientId               String
  fileUrl                 String?
  fileName                String?
  fileType                String?
  status                  PrescriptionStatus       @default(PENDING)
  rejectionReason         String?
  reviewedAt              DateTime?
  aiProcessingStatus      AIProcessingStatus?      @default(PENDING)
  aiProcessingError       String?
  extractedMedications    Json?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  doctorId                String?
  appointmentId           String?
  diagnosis               String?
  notes                   String?
  hospitalId              String?
  dispatchedAt            DateTime?
  qrCodeUrl               String?
  refillsAllowed          Int                      @default(1)
  refillsRemaining        Int                      @default(1)
  verificationHash        String?
  cartItems               CartItem[]
  order                   Order?
  prescriptionMedications PrescriptionMedication[]
  appointment             Appointment?             @relation(fields: [appointmentId], references: [id])
  doctor                  Doctor?                  @relation("DoctorToPrescription", fields: [doctorId], references: [id])
  hospital                Hospital?                @relation(fields: [hospitalId], references: [id])
  patient                 Patient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([status])
  @@index([hospitalId])
  @@map("prescriptions")
}

model PrescriptionMedication {
  id                          String             @id @default(uuid())
  prescriptionId              String
  medicationName              String
  dosage                      String?
  frequency                   String?
  duration                    String?
  quantity                    Int                @default(1)
  matchedMedicationId         String?
  available                   Boolean            @default(false)
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  dispenseStatus              DispenseStatus     @default(PENDING)
  fulfilledAt                 DateTime?
  hospitalDrugStockDrugId     String?
  hospitalDrugStockHospitalId String?
  isHospitalMed               Boolean            @default(false)
  pharmacyId                  String?
  hospitalDrugStock           HospitalDrugStock? @relation(fields: [hospitalDrugStockDrugId, hospitalDrugStockHospitalId], references: [drugId, hospitalId])
  matchedMedication           Medication?        @relation(fields: [matchedMedicationId], references: [id])
  prescription                Prescription       @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@index([matchedMedicationId])
  @@map("prescription_medications")
}

model CartItem {
  id             String        @id @default(uuid())
  patientId      String
  pharmacyId     String
  medicationId   String
  quantity       Int           @default(1)
  prescriptionId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  medication     Medication    @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pharmacy       Pharmacy      @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])

  @@unique([patientId, medicationId])
  @@index([patientId])
  @@index([pharmacyId])
  @@index([medicationId])
  @@map("cart_items")
}

model Order {
  id                      String         @id @default(uuid())
  patientId               String
  pharmacyId              String
  branchId                String?
  orderNumber             String?        @unique
  type                    OrderType
  status                  OrderStatus    @default(PENDING)
  deliveryAddress         String?
  deliveryFee             Float?         @default(0)
  deliveryZone            String?
  prescriptionId          String?        @unique
  subtotal                Float?         @default(0)
  total                   Float
  paymentMethod           PaymentMethod?
  insuranceCoverage       Float?
  patientPayment          Float?
  cancellationReason      String?
  cancelledAt             DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  address                 String?
  adminFee                Float?
  couponCode              String?
  deliveryEmail           String?
  deliveryPhone           String?
  discountAmount          Float?         @default(0)
  hospitalBranchId        String?
  insurancePolicyNumber   String?
  insuranceProvider       String?
  isPrescriptionValidated Boolean?       @default(false)
  latitude                Float?
  longitude               Float?
  orderDate               DateTime?      @default(now())
  phone                   String?
  prescriptionImageUrl    String?
  totalItems              Int?
  paymentStatus           String?
  notifications           Notification[]
  orderItems              OrderItem[]
  branch                  Branch?        @relation(fields: [branchId], references: [id])
  patient                 Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pharmacy                Pharmacy       @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  prescription            Prescription?  @relation(fields: [prescriptionId], references: [id])
  payment                 Payment?

  @@index([patientId])
  @@index([pharmacyId])
  @@index([status])
  @@index([pharmacyId, status, createdAt])
  @@index([branchId, status, createdAt])
  @@index([pharmacyId, createdAt])
  @@index([branchId, createdAt])
  @@map("orders")
}

model OrderItem {
  id           String     @id @default(uuid())
  orderId      String
  medicationId String
  quantity     Int
  price        Float
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([medicationId])
  @@map("order_items")
}

model Payment {
  id                    String        @id @default(uuid())
  orderId               String        @unique
  amount                Decimal       @db.Decimal(12, 2)
  paymentMethod         PaymentMethod
  status                PaymentStatus @default(PENDING)
  transactionId         String?       @unique
  flutterwaveRef        String?       @unique
  insuranceProvider     String?
  insurancePolicyNumber String?
  insuranceCoverage     Float?
  insuranceVerified     Boolean       @default(false)
  paymentResponse       Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  receiptNumber         String?       @unique
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([transactionId])
  @@map("payments")
}

model HospitalPayment {
  id                String        @id @default(uuid())
  invoiceId         String
  patientId         String
  amount            Decimal       @db.Decimal(12, 2)
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  insuranceProvider String?
  insuranceClaimRef String?
  notes             String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  invoice           Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  patient           Patient       @relation(fields: [patientId], references: [id])

  @@index([invoiceId])
  @@map("hospital_payments")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String?
  patientId  String?
  pharmacyId String?
  orderId    String?
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  order      Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  patient    Patient?         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pharmacy   Pharmacy?        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([pharmacyId])
  @@index([orderId])
  @@index([isRead])
  @@index([pharmacyId, isRead])
  @@index([patientId, isRead])
  @@map("notifications")
}

model Attendance {
  id                 String           @id @default(uuid())
  staffId            String
  branchId           String
  clockInTime        DateTime?
  clockInLocation    Json?
  clockInApproved    Boolean          @default(false)
  clockInApprovedAt  DateTime?
  clockInApprovedBy  String?
  clockOutTime       DateTime?
  clockOutLocation   Json?
  clockOutApproved   Boolean          @default(false)
  clockOutApprovedAt DateTime?
  clockOutApprovedBy String?
  status             AttendanceStatus @default(PENDING)
  totalHours         Float?
  notes              String?
  rejectionReason    String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  branch             Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  clockInApprover    Staff?           @relation("ClockInApprover", fields: [clockInApprovedBy], references: [id])
  clockOutApprover   Staff?           @relation("ClockOutApprover", fields: [clockOutApprovedBy], references: [id])
  staff              Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([branchId])
  @@index([clockInTime])
  @@index([status])
  @@index([branchId, status, clockInTime])
  @@map("attendance")
}

model StockTransfer {
  id              String              @id @default(uuid())
  fromBranchId    String
  toBranchId      String
  status          TransferStatus      @default(PENDING)
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  rejectionReason String?
  items           StockTransferItem[]
  fromBranch      Branch              @relation("FromBranch", fields: [fromBranchId], references: [id], onDelete: Cascade)
  toBranch        Branch              @relation("ToBranch", fields: [toBranchId], references: [id], onDelete: Cascade)

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id           String        @id @default(uuid())
  transferId   String
  medicationId String
  quantity     Int
  createdAt    DateTime      @default(now())
  medication   Medication    @relation(fields: [medicationId], references: [id])
  transfer     StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([medicationId])
  @@map("stock_transfer_items")
}

model SupportTicket {
  id           String                @id @default(uuid())
  ticketNumber String                @unique
  name         String
  email        String
  phone        String?
  category     SupportTicketCategory
  message      String
  status       SupportTicketStatus   @default(OPEN)
  userId       String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  user         User?                 @relation(fields: [userId], references: [id])

  @@map("support_tickets")
}

model HospitalInvoice {
  id                 String                @id @default(uuid())
  appointmentId      String?               @unique
  admissionId        String?               @unique
  patientId          String
  hospitalId         String
  totalAmount        Decimal               @db.Decimal(12, 2)
  paymentStatus      HospitalBillingStatus @default(UNPAID)
  insuranceCovered   Boolean               @default(false)
  issuedAt           DateTime              @default(now())
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  items              HospitalInvoiceItem[]
  appointment        Appointment?          @relation(fields: [appointmentId], references: [id])
  inpatientAdmission InpatientAdmission?   @relation(fields: [admissionId], references: [id])
  hospital           Hospital              @relation(fields: [hospitalId], references: [id])
  patient            Patient               @relation(fields: [patientId], references: [id])
  insuranceClaim     InsuranceClaim?

  @@index([patientId])
  @@index([hospitalId])
  @@index([hospitalId, paymentStatus])
  @@index([hospitalId, issuedAt])
  @@index([patientId, paymentStatus])
  @@map("hospital_invoices")
}

model HospitalInvoiceItem {
  id          String          @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int
  unitCost    Decimal         @db.Decimal(12, 2)
  subtotal    Decimal         @db.Decimal(12, 2)
  category    String?
  pharmacyId  String?
  invoice     HospitalInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("hospital_invoice_items")
}

model HospitalConfig {
  id              String   @id @default(uuid())
  hospitalId      String   @unique
  consultationFee Decimal  @default(0) @db.Decimal(12, 2)
  triageFee       Decimal  @default(0) @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  hospital        Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@map("hospital_configs")
}

model InsuranceClaim {
  id            String          @id @default(uuid())
  invoiceId     String          @unique
  provider      String
  claimAmount   Decimal         @db.Decimal(12, 2)
  settledAmount Decimal         @default(0) @db.Decimal(12, 2)
  difference    Decimal         @default(0) @db.Decimal(12, 2)
  status        ClaimStatus     @default(PENDING)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  invoice       HospitalInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("insurance_claims")
}

model PlatformSubscriptionCharge {
  id          String   @id @default(uuid())
  hospitalId  String
  amount      Decimal  @db.Decimal(12, 2)
  description String
  chargedAt   DateTime @default(now())
  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@map("platform_subscription_charges")
}

model TelemedicineSessionLog {
  id            String      @id @default(uuid())
  appointmentId String
  userId        String
  role          String // 'DOCTOR' or 'PATIENT'
  action        String // 'JOIN' or 'LEAVE'
  timestamp     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("telemedicine_session_logs")
}

model MedicalHistoryAccess {
  id        String   @id @default(uuid())
  doctorId  String
  patientId String
  token     String   @unique @default(uuid())
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([patientId])
  @@map("medical_history_access")
}

model MedicalRecordLog {
  id         String   @id @default(uuid())
  doctorId   String?
  patientId  String
  timestamp  DateTime @default(now())
  accessType String // 'TREAT_DOCTOR', 'CONSENT_TOKEN', 'PATIENT_OWN', 'ADMIN'
  reason     String?
  doctor     Doctor?  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([patientId])
  @@map("medical_record_logs")
}

