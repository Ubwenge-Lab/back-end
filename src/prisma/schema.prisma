// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum Role {
  SUPER_ADMIN
  PHARMACY_OWNER
  BRANCH_MANAGER
  PHARMACIST
  CASHIER
  NURSE
}

enum PharmacyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BranchStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AttendanceStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  SICK
  ANNUAL
  MATERNITY
  PATERNITY
  UNPAID
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
  READ
}

// ============================================
// CORE MODELS
// ============================================

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email         String  @unique
  passwordHash  String
  isActive      Boolean @default(true)
  emailVerified Boolean @default(false)

  role Role @default(PHARMACIST)

  // Relations
  staff              Staff?
  pharmacyOwner      PharmacyOwner?
  branchManager      BranchManager?
  notifications      Notification[]
  tokens             RefreshToken[]
  passwordResetToken PasswordResetToken?

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  token     String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ============================================
// PHARMACY & BRANCH MODELS
// ============================================

model Pharmacy {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name              String
  licenseNumber     String           @unique
  phone             String
  email             String
  address           String
  city              String
  country           String
  pharmacyStatus    PharmacyStatus   @default(PENDING)
  rejectionReason   String?
  suspensionReason  String?
  logo              String?
  website           String?
  workingHours      Json?
  servicesOffered   String[]
  insuranceAccepted String[]

  // Relations
  ownerId       String        @unique
  owner         PharmacyOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  branches      Branch[]
  notifications Notification[]

  @@index([ownerId])
  @@index([licenseNumber])
}

model PharmacyOwner {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  phone            String
  nationalId       String  @unique
  businessRegNo    String?
  taxId            String?
  address          String
  city             String
  country          String
  emergencyContact Json?

  // Relations
  pharmacy Pharmacy?

  @@index([userId])
  @@index([nationalId])
}

model Branch {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name                 String
  phone                String
  email                String
  address              String
  city                 String
  branchStatus         BranchStatus @default(PENDING)
  rejectionReason      String?
  suspensionReason     String?
  workingHours         Json?
  tempPasswordHash     String?
  tempPasswordExpiry   DateTime?
  isMainBranch         Boolean      @default(false)
  servicesOffered      String[]
  staffCapacity        Int?
  hasPharmacySection   Boolean      @default(true)
  hasLaboratory        Boolean      @default(false)
  parkingAvailable     Boolean      @default(false)
  wheelchairAccessible Boolean      @default(false)

  // Relations
  pharmacyId String
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  managerId String?        @unique
  manager   BranchManager?

  staff         Staff[]
  attendance    Attendance[]
  leaves        Leave[]
  notifications Notification[]

  @@index([pharmacyId])
  @@index([managerId])
}

model BranchManager {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  phone        String
  dateOfBirth  DateTime
  gender       String
  address      String
  city         String
  nationality  String
  nationalId   String  @unique
  qualification String?
  experience   Int?
  photoUrl     String?

  // Relations
  branchId String @unique
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  approvedClockIns  Attendance[] @relation("ClockInApprover")
  approvedClockOuts Attendance[] @relation("ClockOutApprover")
  approvedLeaves    Leave[]      @relation("LeaveApprover")

  @@index([userId])
  @@index([branchId])
  @@index([nationalId])
}

model Staff {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  phone        String
  dateOfBirth  DateTime
  gender       String
  address      String
  city         String
  nationality  String
  nationalId   String   @unique
  position     String
  department   String?
  hireDate     DateTime @default(now())
  salary       Float?
  workingHours Json?

  // Relations
  branchId   String
  branch     Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  attendance Attendance[]
  leaves     Leave[]

  @@index([userId])
  @@index([branchId])
  @@index([nationalId])
}

// ============================================
// ATTENDANCE & LEAVE MODELS
// ============================================

model Attendance {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  date              DateTime         @default(now())
  clockInTime       DateTime?
  clockOutTime      DateTime?
  clockInLocation   Json?
  clockOutLocation  Json?
  status            AttendanceStatus @default(PENDING)
  notes             String?
  rejectionReason   String?
  hoursWorked       Float?
  overtimeHours     Float?

  // Relations
  staffId  String
  staff    Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  clockInApproverId  String?
  clockInApprover    BranchManager? @relation("ClockInApprover", fields: [clockInApproverId], references: [id])
  clockOutApproverId String?
  clockOutApprover   BranchManager? @relation("ClockOutApprover", fields: [clockOutApproverId], references: [id])

  @@index([staffId])
  @@index([branchId])
  @@index([date])
  @@index([status])
  @@index([clockInApproverId])
  @@index([clockOutApproverId])
}

model Leave {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  startDate       DateTime
  endDate         DateTime
  leaveType       LeaveType
  reason          String
  status          LeaveStatus      @default(PENDING)
  rejectionReason String?
  daysRequested   Int
  attachmentUrl   String?

  // Relations
  staffId   String
  staff     Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  approverId String?
  approver  BranchManager? @relation("LeaveApprover", fields: [approverId], references: [id])

  @@index([staffId])
  @@index([branchId])
  @@index([status])
  @@index([approverId])
}

// ============================================
// NOTIFICATION MODEL
// ============================================

model Notification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type               NotificationType
  status             NotificationStatus @default(PENDING)
  title              String
  message            String
  recipientEmail     String?
  recipientPhone     String?
  scheduledFor       DateTime?
  sentAt             DateTime?
  deliveredAt        DateTime?
  readAt             DateTime?
  errorMessage       String?
  retryCount         Int                @default(0)
  maxRetries         Int                @default(3)
  metadata           Json?
  templateId         String?
  priority           String             @default("normal")
  expiresAt          DateTime?

  // Relations
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  pharmacyId String?
  pharmacy   Pharmacy?  @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  branchId   String?
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([pharmacyId])
  @@index([branchId])
  @@index([status])
  @@index([type])
  @@index([scheduledFor])
}
