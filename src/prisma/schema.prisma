generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String          @id @default(uuid())
  email                  String          @unique
  password               String
  role                   UserRole
  isVerified             Boolean         @default(false)
  verificationCode       String?
  verificationCodeExpiry DateTime?
  refreshToken           String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  isActive               Boolean         @default(true)
  managedBranch          Branch?         @relation("BranchManager")
  patient                Patient?
  pharmacy               Pharmacy?       @relation("PharmacyOwner")
  staff                  Staff?
  doctor                 Doctor?
  hospital               Hospital?       @relation("HospitalOwner")
  hospitalStaff          HospitalStaff?
  SupportTickets         SupportTicket[]

  @@index([email])
  @@map("users")
}

model Hospital {
  id                    String                        @id @default(uuid())
  userId                String                        @unique
  name                  String
  representativeName    String?
  address               String
  phone                 String
  latitude              Float?
  longitude             Float?
  dateOfIncorporation   DateTime?
  rdbCertificate        String?
  pharmacyLicense       String?
  businessRegistration  String?
  status                PharmacyStatus                @default(PENDING)
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  user                  User                          @relation("HospitalOwner", fields: [userId], references: [id], onDelete: Cascade)
  staff                 HospitalStaff[]
  doctors               Doctor[]
  appointments          Appointment[]
  drugStock             HospitalDrugStock[]
  invoices              Invoice[]
  hospitalRegistrations HospitalPatientRegistration[]

  @@index([userId])
  @@map("hospitals")
}

model Doctor {
  id             String   @id @default(uuid())
  userId         String   @unique
  hospitalId     String
  specialization String
  licenseNumber  String   @unique
  bio            String?
  rating         Float    @default(0)
  isAvailable    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital      Hospital       @relation(fields: [hospitalId], references: [id])
  appointments  Appointment[]
  prescriptions Prescription[] @relation("DoctorToPrescription")

  @@index([hospitalId])
  @@index([specialization])
  @@map("doctors")
}

model HospitalStaff {
  id                 String      @id @default(uuid())
  userId             String      @unique
  hospitalId         String
  firstName          String
  lastName           String
  phone              String?
  status             StaffStatus @default(ACTIVE)
  tempPasswordHash   String?
  tempPasswordExpiry DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  hospital           Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([userId])
  @@map("hospital_staff")
}

model Patient {
  id                    String                        @id @default(uuid())
  userId                String                        @unique
  firstName             String
  lastName              String
  phone                 String
  dateOfBirth           DateTime?
  gender                String?
  address               String?
  nationalId            String?
  insuranceProvider     String?
  insurancePolicy       String?
  insuranceMemberId     String?
  insuranceCoverage     Int?                          @default(0)
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  lastLat               Float?
  lastLng               Float?
  cartItems             CartItem[]
  appointments          Appointment[]
  invoices              Invoice[]
  notifications         Notification[]
  orders                Order[]
  user                  User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescriptions         Prescription[]
  hospitalRegistrations HospitalPatientRegistration[]
  hospitalPayments      HospitalPayment[]

  @@index([userId])
  @@map("patients")
}

model HospitalPatientRegistration {
  id           String   @id @default(uuid())
  patientId    String
  hospitalId   String
  mrn          String
  registeredAt DateTime @default(now())

  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([patientId, hospitalId])
  @@unique([hospitalId, mrn])
  @@index([patientId])
  @@index([hospitalId])
  @@map("hospital_patient_registrations")
}

model Pharmacy {
  id                   String         @id @default(uuid())
  userId               String         @unique
  name                 String
  phone                String
  address              String
  latitude             Float?
  longitude            Float?
  dateOfIncorporation  DateTime?
  rdbCertificate       String?
  pharmacyLicense      String?
  businessRegistration String?
  status               PharmacyStatus @default(PENDING)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  branches             Branch[]
  user                 User           @relation("PharmacyOwner", fields: [userId], references: [id], onDelete: Cascade)
  cartItems            CartItem[]
  orders               Order[]
  notifications        Notification[]

  @@index([userId])
  @@map("pharmacies")
}

model Branch {
  id            String       @id @default(uuid())
  pharmacyId    String
  name          String
  address       String
  phone         String
  latitude      Float?
  longitude     Float?
  managerId     String?      @unique
  status        BranchStatus @default(INVITED)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  attendance    Attendance[]
  manager       User?        @relation("BranchManager", fields: [managerId], references: [id])
  pharmacy      Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medications   Medication[]
  staff         Staff[]
  transfersFrom Transfer[]   @relation("FromBranch")
  transfersTo   Transfer[]   @relation("ToBranch")

  @@index([pharmacyId])
  @@map("branches")
}

model Staff {
  id               String       @id @default(uuid())
  userId           String       @unique
  branchId         String
  firstName        String
  lastName         String
  phone            String?
  status           StaffStatus  @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  clockInApprover  Attendance[] @relation("ClockInApprover")
  clockOutApprover Attendance[] @relation("ClockOutApprover")
  branch           Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendances      Attendance[]

  @@index([branchId])
  @@map("staff")
}

model Medication {
  id                     String                   @id @default(uuid())
  branchId               String
  name                   String
  description            String?
  category               String?
  price                  Float
  quantity               Int                      @default(0)
  requiresPrescription   Boolean                  @default(false)
  expiryDate             DateTime?
  manufacturer           String?
  batchNumber            String?
  imageUrl               String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  cartItems              CartItem[]
  branch                 Branch                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orderItems             OrderItem[]
  prescriptionMedications PrescriptionMedication[]

  @@index([branchId])
  @@map("medications")
}

model HospitalDrugStock {
  id                   String    @id @default(uuid())
  hospitalId           String
  name                 String
  description          String?
  category             String?
  unitPrice            Float
  quantity             Int       @default(0)
  requiresPrescription Boolean   @default(false)
  expiryDate           DateTime?
  manufacturer         String?
  batchNumber          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  hospital             Hospital  @relation(fields: [hospitalId], references: [id])

  @@map("hospital_drug_stock")
}

model Invoice {
  id               String            @id @default(uuid())
  hospitalId       String
  patientId        String
  totalAmount      Decimal           @db.Decimal(12, 2)
  status           InvoiceStatus     @default(UNPAID)
  dueDate          DateTime
  createdAt        DateTime          @default(now())
  paymentId        String?
  hospital         Hospital          @relation(fields: [hospitalId], references: [id])
  patient          Patient           @relation(fields: [patientId], references: [id])
  items            InvoiceItem[]
  payment          Payment?          @relation(fields: [paymentId], references: [id])
  hospitalPayments HospitalPayment[]

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Appointment {
  id           String            @id @default(uuid())
  patientId    String
  hospitalId   String
  doctorId     String
  date         DateTime
  reason       String?
  status       AppointmentStatus @default(SCHEDULED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  doctor       Doctor            @relation(fields: [doctorId], references: [id])
  hospital     Hospital          @relation(fields: [hospitalId], references: [id])
  patient      Patient           @relation(fields: [patientId], references: [id])
  prescriptions Prescription[]

  @@index([patientId])
  @@index([hospitalId])
  @@index([doctorId])
  @@map("appointments")
}

model Prescription {
  id                      String                   @id @default(uuid())
  patientId               String
  doctorId                String?
  appointmentId           String?
  diagnosis               String?
  notes                   String?
  status                  PrescriptionStatus       @default(PENDING)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  cartItems               CartItem[]
  order                   Order?
  prescriptionMedications PrescriptionMedication[]
  appointment             Appointment?             @relation(fields: [appointmentId], references: [id])
  patient                 Patient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor                  Doctor?                  @relation("DoctorToPrescription", fields: [doctorId], references: [id])

  @@index([patientId])
  @@index([status])
  @@map("prescriptions")
}

model PrescriptionMedication {
  id                  String       @id @default(uuid())
  prescriptionId      String
  medicationName      String
  dosage              String?
  frequency           String?
  duration            String?
  quantity            Int          @default(1)
  matchedMedicationId String?
  available           Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  matchedMedication   Medication?  @relation(fields: [matchedMedicationId], references: [id])
  prescription        Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@index([matchedMedicationId])
  @@map("prescription_medications")
}

model CartItem {
  id             String        @id @default(uuid())
  patientId      String
  pharmacyId     String
  medicationId   String
  quantity       Int           @default(1)
  prescriptionId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  medication     Medication    @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pharmacy       Pharmacy      @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])

  @@unique([patientId, medicationId])
  @@index([patientId])
  @@index([pharmacyId])
  @@index([medicationId])
  @@map("cart_items")
}

model Order {
  id             String         @id @default(uuid())
  patientId      String
  pharmacyId     String
  prescriptionId String?        @unique
  totalAmount    Float
  status         OrderStatus    @default(PENDING)
  type           OrderType
  address        String?
  phone          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  notifications  Notification[]
  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pharmacy       Pharmacy       @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  prescription   Prescription?  @relation(fields: [prescriptionId], references: [id])
  items          OrderItem[]
  payment        Payment?

  @@index([patientId])
  @@index([pharmacyId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           String     @id @default(uuid())
  orderId      String
  medicationId String
  quantity     Int
  price        Float
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([medicationId])
  @@map("order_items")
}

model Payment {
  id                    String        @id @default(uuid())
  orderId               String        @unique
  amount                Decimal       @db.Decimal(12, 2)
  paymentMethod         PaymentMethod
  status                PaymentStatus @default(PENDING)
  transactionId         String?       @unique
  flutterwaveRef        String?       @unique
  receiptNumber         String?       @unique
  insuranceProvider     String?
  insurancePolicyNumber String?
  insuranceCoverage     Float?
  insuranceVerified     Boolean       @default(false)
  paymentResponse       Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  invoices              Invoice[]
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([transactionId])
  @@map("payments")
}

model HospitalPayment {
  id                String        @id @default(uuid())
  invoiceId         String
  patientId         String
  amount            Decimal       @db.Decimal(12, 2)
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  insuranceProvider String?
  insuranceClaimRef String?
  notes             String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([invoiceId])
  @@map("hospital_payments")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String?
  patientId  String?
  pharmacyId String?
  orderId    String?
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  order      Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  patient    Patient?         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pharmacy   Pharmacy?        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([pharmacyId])
  @@index([orderId])
  @@index([isRead])
  @@map("notifications")
}

model Attendance {
  id                 String           @id @default(uuid())
  staffId            String
  branchId           String
  clockInTime        DateTime?
  clockInLocation    Json?
  clockInApproved    Boolean          @default(false)
  clockInApprovedAt  DateTime?
  clockInApprovedBy  String?
  clockOutTime       DateTime?
  clockOutLocation   Json?
  clockOutApproved   Boolean          @default(false)
  clockOutApprovedAt DateTime?
  clockOutApprovedBy String?
  status             AttendanceStatus @default(PENDING)
  totalHours         Float?
  notes              String?
  rejectionReason    String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  branch             Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  clockInApprover    Staff?           @relation("ClockInApprover", fields: [clockInApprovedBy], references: [id])
  clockOutApprover   Staff?           @relation("ClockOutApprover", fields: [clockOutApprovedBy], references: [id])
  staff              Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([branchId])
  @@index([clockInTime])
  @@index([status])
  @@map("attendance")
}

model Transfer {
  id              String         @id @default(uuid())
  fromBranchId    String
  toBranchId      String
  medicationName  String
  quantity        Int
  status          TransferStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  fromBranch      Branch         @relation("FromBranch", fields: [fromBranchId], references: [id], onDelete: Cascade)
  toBranch        Branch         @relation("ToBranch", fields: [toBranchId], references: [id], onDelete: Cascade)

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
  @@map("transfers")
}

model SupportTicket {
  id           String                @id @default(uuid())
  ticketNumber String                @unique
  name         String
  email        String
  phone        String?
  category     SupportTicketCategory
  message      String
  status       SupportTicketStatus   @default(OPEN)
  userId       String?
  user         User?                 @relation(fields: [userId], references: [id])
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@map("support_tickets")
}

enum UserRole {
  SUPER_ADMIN
  PHARMACY
  PATIENT
  BRANCH_MANAGER
  PHARMACIST
  CASHIER
  HOSPITAL_ADMIN
  DOCTOR
  RECEPTIONIST
  NURSE
}

enum PharmacyStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  OUT_FOR_DELIVERY
  READY_FOR_PICKUP
  DELIVERED
  COMPLETED
  CANCELLED
}

enum OrderType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  MTN_MOMO
  AIRTEL_MONEY
  CARD
  CASH
  INSURANCE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  ORDER_PLACED
  ORDER_ACCEPTED
  ORDER_PREPARING
  ORDER_OUT_FOR_DELIVERY
  ORDER_READY_FOR_PICKUP
  ORDER_DELIVERED
  ORDER_CANCELLED
  PRESCRIPTION_REJECTED
  PRESCRIPTION_APPROVED
  PHARMACY_APPROVED
  PHARMACY_REJECTED
  LOW_STOCK
}

enum PrescriptionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AIProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  SHIPPED
  COMPLETED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum BranchStatus {
  INVITED
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PENDING
  APPROVED
  CLOCKED_OUT
  COMPLETED
  REJECTED
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  VOID
}

enum SupportTicketCategory {
  order_issue
  billing
  technical
  account
  other
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}
