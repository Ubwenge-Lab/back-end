model OperatingTheater {
  id         String           @id @default(uuid())
  hospitalId String
  name       String
  roomNumber String
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  hospital   Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  bookings   SurgeryBooking[]

  @@unique([hospitalId, roomNumber])
  @@map("operating_theaters")
}

model SurgeryBooking {
  id                String        @id @default(uuid())
  hospitalId        String
  theaterId         String
  patientId         String
  procedureName     String
  startTime         DateTime
  endTime           DateTime
  status            SurgeryStatus @default(SCHEDULED)
  requiredEquipment String[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  durationMinutes   Int?
  anesthesiaDetails String?
  operationNotes    String?
  complications     String?
  outcome           String?
  reportLoggedAt    DateTime?

  hospital        Hospital                 @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  theater         OperatingTheater         @relation(fields: [theaterId], references: [id], onDelete: Cascade)
  patient         Patient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  teamAssignments SurgicalTeamAssignment[]
  inventoryDeducted Boolean @default(false)

  @@index([theaterId])
  @@index([startTime, endTime])
  @@map("surgery_bookings")
}

model SurgicalTeamAssignment {
  id        String       @id @default(uuid())
  bookingId String
  role      SurgicalRole

  doctorId        String?
  hospitalStaffId String?

  booking       SurgeryBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  doctor        Doctor?        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospitalStaff HospitalStaff? @relation(fields: [hospitalStaffId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([doctorId])
  @@index([hospitalStaffId])
  @@map("surgical_team_assignments")
}

enum SurgeryStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum SurgicalRole {
  SURGEON
  ANESTHESIOLOGIST
  ASSISTANT_SURGEON
  SCRUB_NURSE
  CIRCULATING_NURSE
}

// =============================================
// INPATIENT ADMISSIONS, VITALS, MAR, HANDOVER
// =============================================

model InpatientAdmission {
  id               String          @id @default(uuid())
  patientId        String
  hospitalId       String
  bedId            String?
  doctorId         String?
  admittedByUserId String
  admittedByName   String
  admittedByRole   String
  wardName         String?
  bedNumber        String?
  reason           String
  status           AdmissionStatus @default(ACTIVE)
  admittedAt       DateTime        @default(now())
  dischargedAt     DateTime?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  patient            Patient             @relation(fields: [patientId], references: [id])
  hospital           Hospital            @relation(fields: [hospitalId], references: [id])
  bed                Bed?                @relation(fields: [bedId], references: [id])
  doctor             Doctor?             @relation(fields: [doctorId], references: [id])
  vitals             InpatientVitals[]
  marLogs            MARLog[]
  handovers          NursingHandover[]
  supplyConsumptions SupplyConsumption[]
  hospitalInvoice    HospitalInvoice?

  @@index([patientId])
  @@index([hospitalId])
  @@index([status])
  @@map("inpatient_admissions")
}

model InpatientVitals {
  id           String   @id @default(uuid())
  admissionId  String
  recordedById String
  readings     Json
  checklist    Json
  nurseNotes   String?
  recordedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  admission InpatientAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  nurse     HospitalStaff      @relation("VitalsNurse", fields: [recordedById], references: [id])

  @@index([admissionId])
  @@index([recordedAt])
  @@map("inpatient_vitals")
}

model MARLog {
  id                String    @id @default(uuid())
  admissionId       String
  administeredById  String
  medicationName    String
  dose              String
  route             String?
  prescriptionMedId String?
  scheduledAt       DateTime?
  administeredAt    DateTime
  notes             String?
  createdAt         DateTime  @default(now())

  admission InpatientAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  nurse     HospitalStaff      @relation("MARNurse", fields: [administeredById], references: [id])

  @@index([admissionId])
  @@index([administeredAt])
  @@map("mar_logs")
}

model NursingHandover {
  id             String    @id @default(uuid())
  admissionId    String
  handedOverById String
  receivedById   String?
  shiftType      ShiftType
  checklist      Json
  notes          String?
  handedOverAt   DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  admission     InpatientAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  outgoingNurse HospitalStaff      @relation("HandoverOutgoing", fields: [handedOverById], references: [id])
  incomingNurse HospitalStaff?     @relation("HandoverIncoming", fields: [receivedById], references: [id])

  @@index([admissionId])
  @@map("nursing_handovers")
}

enum AdmissionStatus {
  ACTIVE
  DISCHARGED
  TRANSFERRED
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
}

enum ReferralStatus {
  PENDING
  PACKAGED
  SENT
  FAILED
}

model Referral {
  id                  String         @id @default(uuid())
  patientId           String
  sourceHospitalId    String
  targetHospitalId    String
  authorizingDoctorId String
  reason              String
  status              ReferralStatus @default(PENDING)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  emrJsonPayload Json?
  emrPdfFileUrl  String?
  exportedAt     DateTime?

  webhookSignature   String?
  webhookHttpStatus  Int?
  webhookAttemptedAt DateTime?
  webhookError       String?

  patient           Patient  @relation(fields: [patientId], references: [id])
  sourceHospital    Hospital @relation("ReferralSource", fields: [sourceHospitalId], references: [id])
  targetHospital    Hospital @relation("ReferralTarget", fields: [targetHospitalId], references: [id])
  authorizingDoctor Doctor   @relation(fields: [authorizingDoctorId], references: [id])

  @@index([sourceHospitalId])
  @@index([targetHospitalId])
  @@index([patientId])
  @@index([status])
  @@map("referrals")
}

enum DiagnosticType {
  BLOOD
  URINE
  XRAY
  MRI
}

enum DiagnosticStatus {
  PENDING
  COLLECTED
  IN_PROGRESS
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

model DiagnosticOrder {
  id               String           @id @default(uuid())
  patientId        String
  doctorId         String
  appointmentId    String?
  testType         DiagnosticType
  icd10Code        String
  status           DiagnosticStatus @default(PENDING)
  findings         String?
  resultValue      String?
  structuredResult Json?
  fileUrl          String?
  fileName         String?
  fileType         String?
  technicianId     String?
  rejectedById     String?
  rejectionReason  String?
  rejectedAt       DateTime?
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  revisions   LabResultRevision[]

  inventoryDeducted Boolean @default(false)

  @@map("diagnostic_orders")
}

model LabResultRevision {
  id                String   @id @default(uuid())
  diagnosticOrderId String
  fileUrl           String?
  fileName          String?
  fileType          String?
  findings          String?
  resultValue       String?
  structuredResult  Json?
  correctedById     String
  correctionReason  String
  createdAt         DateTime @default(now())

  diagnosticOrder DiagnosticOrder @relation(fields: [diagnosticOrderId], references: [id], onDelete: Cascade)

  @@index([diagnosticOrderId])
  @@map("lab_result_revisions")
}

model HospitalConsumableStock {
  id                String   @id @default(uuid())
  hospitalId        String
  itemName          String
  quantity          Int      @default(0)
  criticalThreshold Int      @default(10)
  lastUpdated       DateTime @default(now()) @updatedAt

  hospital Hospital                  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  boms     DiagnosticConsumableBOM[]
  surgeryBoms SurgeryConsumableBOM[]

  @@unique([hospitalId, itemName])
  @@map("hospital_consumable_stock")
}

model DiagnosticConsumableBOM {
  id             String         @id @default(uuid())
  diagnosticType DiagnosticType
  consumableId   String
  quantityUsed   Int

  consumable HospitalConsumableStock @relation(fields: [consumableId], references: [id], onDelete: Cascade)

  @@unique([diagnosticType, consumableId])
  @@map("diagnostic_consumable_bom")
}

model SurgeryConsumableBOM {
  id            String   @id @default(uuid())
  procedureName String   // Matches SurgeryBooking.procedureName
  consumableId  String
  quantityUsed  Int

  consumable HospitalConsumableStock @relation(fields: [consumableId], references: [id], onDelete: Cascade)

  @@unique([procedureName, consumableId])
  @@map("surgery_consumable_bom")
}

enum WardTier {
  GENERAL
  ICU
  MATERNITY
  PEDIATRIC
  PRIVATE
}

model Ward {
  id            String   @id @default(uuid())
  hospitalId    String
  name          String
  tier          WardTier
  baseBedCharge Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  beds          Bed[]
  hospital      Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@map("wards")
}

model Bed {
  id                  String               @id @default(uuid())
  wardId              String
  number              String
  isOccupied          Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  inpatientAdmissions InpatientAdmission[]
  ward                Ward                 @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@index([wardId])
  @@map("beds")
}

model SupplyConsumption {
  id                 String             @id @default(uuid())
  admissionId        String
  itemName           String
  category           String
  quantity           Int
  unitCost           Decimal            @db.Decimal(12, 2)
  totalCost          Decimal            @db.Decimal(12, 2)
  administeredBy     String
  timestamp          DateTime           @default(now())
  inpatientAdmission InpatientAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@map("supply_consumptions")
}

model AuditLog {
  id         String  @id @default(uuid())
  actorId    String?
  actorRole  String?
  actorEmail String?

  targetId      String?
  targetType    String?
  action        String?
  outcome       String   @default("SUCCESS")
  ip            String?
  userAgent     String?
  correlationId String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@index([actorRole])
  @@index([createdAt])
}

model ChatMessage {
  id            String      @id @default(uuid())
  appointmentId String
  senderId      String
  receiverId    String
  content       String      @db.Text
  isRead        Boolean     @default(false)
  createdAt     DateTime    @default(now())

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  sender        User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver      User        @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@map("chat_messages")
}
