generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String          @id @default(uuid())
  email                  String          @unique
  password               String
  role                   UserRole
  isVerified             Boolean         @default(false)
  verificationCode       String?
  verificationCodeExpiry DateTime?
  refreshToken           String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  isActive               Boolean         @default(true)
  firstName              String?
  lastName               String?
  managedBranch          Branch?         @relation("BranchManager")
  doctor                 Doctor?
  hospitalStaff          HospitalStaff?
  hospital               Hospital?       @relation("HospitalOwner")
  patient                Patient?
  pharmacy               Pharmacy?       @relation("PharmacyOwner")
  staff                  Staff?
  SupportTickets         SupportTicket[]

  @@index([email])
  @@map("users")
}

model Hospital {
  id                    String                        @id @default(uuid())
  userId                String                        @unique
  name                  String
  representativeName    String?
  address               String
  phone                 String
  latitude              Float?
  longitude             Float?
  dateOfIncorporation   DateTime?
  rdbCertificate        String?
  pharmacyLicense       String?
  businessRegistration  String?
  status                PharmacyStatus                @default(PENDING)
  licenseNumber         String?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  appointments          Appointment[]
  doctors               Doctor[]
  drugStock             HospitalDrugStock[]
  hospitalRegistrations HospitalPatientRegistration[]
  staff                 HospitalStaff[]
  user                  User                          @relation("HospitalOwner", fields: [userId], references: [id], onDelete: Cascade)
  invoices              Invoice[]

  @@index([userId])
  @@map("hospitals")
}

model Doctor {
  id             String         @id @default(uuid())
  userId         String         @unique
  hospitalId     String
  specialization String
  licenseNumber  String         @unique
  bio            String?
  rating         Float          @default(0)
  isAvailable    Boolean        @default(true)
  schedules      DoctorSchedule[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  appointments   Appointment[]
  hospital       Hospital       @relation(fields: [hospitalId], references: [id])
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescriptions  Prescription[] @relation("DoctorToPrescription")

  @@index([hospitalId])
  @@index([specialization])
  @@map("doctors")
}


// --- Doctor Schedule ---
model DoctorSchedule {
  id        String   @id @default(uuid())
  doctorId  String
  dayOfWeek Int      // 0 (Sunday) to 6 (Saturday)
  startTime String   // e.g., "08:00"
  endTime   String   // e.g., "17:00"

  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek, startTime])
  @@map("doctor_schedules")
}



model HospitalStaff {
  id                 String      @id @default(uuid())
  userId             String      @unique
  hospitalId         String
  firstName          String
  lastName           String
  phone              String?
  status             StaffStatus @default(ACTIVE)
  tempPasswordHash   String?
  tempPasswordExpiry DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  hospital           Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([userId])
  @@map("hospital_staff")
}


model Patient {
  id                    String                        @id @default(uuid())
  userId                String                        @unique
  firstName             String
  lastName              String
  phone                 String
  mrn                   String?
  dateOfBirth           DateTime?
  gender                String?
  address               String?
  nationalId            String?
  insuranceProvider     String?
  insurancePolicy       String?
  insuranceMemberId     String?
  insuranceCoverage     Int?                          @default(0)
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  lastLat               Float?
  lastLng               Float?
  appointments          Appointment[]
  cartItems             CartItem[]
  hospitalRegistrations HospitalPatientRegistration[]
  hospitalPayments      HospitalPayment[]
  invoices              Invoice[]
  notifications         Notification[]
  orders                Order[]
  user                  User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescriptions         Prescription[]

  @@index([userId])
  @@map("patients")
}

model HospitalPatientRegistration {
  id           String   @id @default(uuid())
  patientId    String
  hospitalId   String
  mrn          String
  registeredAt DateTime @default(now())
  hospital     Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, hospitalId])
  @@unique([hospitalId, mrn])
  @@index([patientId])
  @@index([hospitalId])
  @@map("hospital_patient_registrations")
}

model Pharmacy {
  id                   String         @id @default(uuid())
  userId               String         @unique
  name                 String
  phone                String
  address              String
  latitude             Float?
  longitude            Float?
  dateOfIncorporation  DateTime?
  rdbCertificate       String?
  pharmacyLicense      String?
  businessRegistration String?
  representativeName   String?
  rejectionReason      String?
  status               PharmacyStatus @default(PENDING)
  approvedAt           DateTime?
  isLocationVerified   Boolean        @default(false)
  locationVerifiedAt   DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  operatingHours       Json?
  isActive             Boolean        @default(true)
  branches             Branch[]
  cartItems            CartItem[]
  medications          Medication[]
  notifications        Notification[]
  orders               Order[]
  user                 User           @relation("PharmacyOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pharmacies")
}

model Branch {
  id                 String          @id @default(uuid())
  pharmacyId         String
  name               String
  address            String
  phone              String
  latitude           Float?
  longitude          Float?
  managerId          String?         @unique
  status             BranchStatus    @default(INVITED)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  operatingHours     Json?
  isActive           Boolean         @default(true)
  branchStatus       BranchStatus    @default(INVITED)
  isLocationVerified Boolean         @default(false)
  locationVerifiedAt DateTime?
  pharmacyLicense    String?
  branchManagerEmail String?
  branchManagerName  String?
  tempPasswordHash   String?
  tempPasswordExpiry DateTime?
  licenseUrl         String?
  attendance         Attendance[]
  manager            User?           @relation("BranchManager", fields: [managerId], references: [id])
  pharmacy           Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medications        Medication[]
  orders             Order[]
  staff              Staff[]
  transfersFrom      StockTransfer[] @relation("FromBranch")
  transfersTo        StockTransfer[] @relation("ToBranch")

  @@index([pharmacyId])
  @@map("branches")
}

model Staff {
  id                 String            @id @default(uuid())
  userId             String            @unique
  branchId           String
  firstName          String
  lastName           String
  phone              String?
  gender             String?
  dateOfBirth        DateTime?
  address            String?
  nationalId         String?           @unique
  workingHours       Json?
  status             StaffStatus       @default(ACTIVE)
  tempPasswordHash   String?
  tempPasswordExpiry DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  clockInApprover    Attendance[]      @relation("ClockInApprover")
  clockOutApprover   Attendance[]      @relation("ClockOutApprover")
  attendances        Attendance[]
  branch             Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions        StaffPermissions?

  @@index([branchId])
  @@map("staff")
}

model StaffPermissions {
  id          String   @id @default(uuid())
  staffId     String   @unique
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("staff_permissions")
}

model MedicationRegistry {
  id                  String       @id @default(uuid())
  registrationNumber  String       @unique
  brandName           String
  genericName         String
  dosageStrength      String
  dosageForm          String
  packSize            String
  packagingType       String
  shelfLife           String
  manufacturerName    String
  manufacturerAddress String
  manufacturerCountry String
  marketingAuthHolder String?
  localTechRep        String?
  registrationDate    DateTime
  expiryDate          DateTime?
  medications         Medication[]

  @@index([brandName])
  @@index([genericName])
  @@index([registrationNumber])
  @@map("medication_registry")
}

model Medication {
  id                      String                   @id @default(uuid())
  branchId                String
  pharmacyId              String?
  registryId              String?
  name                    String
  chemicalName            String?
  description             String?
  category                String?
  price                   Float
  quantity                Int                      @default(0)
  lowStockThreshold       Int                      @default(10)
  requiresPrescription    Boolean                  @default(false)
  expiryDate              DateTime?
  manufacturer            String?
  batchNumber             String?
  imageUrl                String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  cartItems               CartItem[]
  branch                  Branch                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  pharmacy                Pharmacy?                @relation(fields: [pharmacyId], references: [id])
  registry                MedicationRegistry?      @relation(fields: [registryId], references: [id])
  orderItems              OrderItem[]
  prescriptionMedications PrescriptionMedication[]
  transferItems           StockTransferItem[]

  @@index([branchId])
  @@map("medications")
}

model HospitalDrugStock {
  id                   String    @id @default(uuid())
  hospitalId           String
  name                 String
  description          String?
  category             String?
  unitPrice            Float
  quantity             Int       @default(0)
  requiresPrescription Boolean   @default(false)
  expiryDate           DateTime?
  manufacturer         String?
  batchNumber          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  hospital             Hospital  @relation(fields: [hospitalId], references: [id])

  @@map("hospital_drug_stock")
}

model Invoice {
  id               String            @id @default(uuid())
  hospitalId       String
  patientId        String
  totalAmount      Decimal           @db.Decimal(12, 2)
  status           InvoiceStatus     @default(UNPAID)
  dueDate          DateTime
  createdAt        DateTime          @default(now())
  paymentId        String?
  hospitalPayments HospitalPayment[]
  items            InvoiceItem[]
  hospital         Hospital          @relation(fields: [hospitalId], references: [id])
  patient          Patient           @relation(fields: [patientId], references: [id])
  payment          Payment?          @relation(fields: [paymentId], references: [id])

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Appointment {
  id            String            @id @default(uuid())
  patientId     String
  hospitalId    String
  doctorId      String
  date          DateTime
  reason        String?
  status        AppointmentStatus @default(SCHEDULED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  doctor        Doctor            @relation(fields: [doctorId], references: [id])
  hospital      Hospital          @relation(fields: [hospitalId], references: [id])
  patient       Patient           @relation(fields: [patientId], references: [id])
  prescriptions Prescription[]

  @@index([patientId])
  @@index([hospitalId])
  @@index([doctorId])
  @@map("appointments")
}

model Prescription {
  id                      String                   @id @default(uuid())
  patientId               String
  doctorId                String?
  appointmentId           String?
  diagnosis               String?
  notes                   String?
  status                  PrescriptionStatus       @default(PENDING)
  rejectionReason         String?
  reviewedAt              DateTime?
  aiProcessingStatus      AIProcessingStatus?      @default(PENDING)
  aiProcessingError       String?
  extractedMedications    Json?
  fileUrl                 String?
  fileName                String?
  fileType                String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  cartItems               CartItem[]
  order                   Order?
  prescriptionMedications PrescriptionMedication[]
  appointment             Appointment?             @relation(fields: [appointmentId], references: [id])
  doctor                  Doctor?                  @relation("DoctorToPrescription", fields: [doctorId], references: [id])
  patient                 Patient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([status])
  @@map("prescriptions")
}

model PrescriptionMedication {
  id                  String       @id @default(uuid())
  prescriptionId      String
  medicationName      String
  dosage              String?
  frequency           String?
  duration            String?
  quantity            Int          @default(1)
  matchedMedicationId String?
  available           Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  matchedMedication   Medication?  @relation(fields: [matchedMedicationId], references: [id])
  prescription        Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@index([matchedMedicationId])
  @@map("prescription_medications")
}

model CartItem {
  id             String        @id @default(uuid())
  patientId      String
  pharmacyId     String
  medicationId   String
  quantity       Int           @default(1)
  prescriptionId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  medication     Medication    @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pharmacy       Pharmacy      @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])

  @@unique([patientId, medicationId])
  @@index([patientId])
  @@index([pharmacyId])
  @@index([medicationId])
  @@map("cart_items")
}

model Order {
  id                      String         @id @default(uuid())
  patientId               String
  pharmacyId              String
  branchId                String?
  prescriptionId          String?        @unique
  orderNumber             String?        @unique
  total                   Float
  status                  OrderStatus    @default(PENDING)
  type                    OrderType
  paymentMethod           PaymentMethod?
  address                 String?
  phone                   String?
  insuranceProvider       String?
  insurancePolicyNumber   String?
  insuranceCoverage       Float?
  paymentStatus           String?
  patientPayment          Float?
  adminFee                Float?
  totalItems              Int?
  hospitalBranchId        String?
  cancellationReason      String?
  cancelledAt             DateTime?
  deliveryAddress         String?
  deliveryPhone           String?
  deliveryEmail           String?
  deliveryFee             Float?         @default(0)
  discountAmount          Float?         @default(0)
  couponCode              String?
  deliveryZone            String?
  latitude                Float?
  longitude               Float?
  subtotal                Float?         @default(0)
  prescriptionImageUrl    String?
  isPrescriptionValidated Boolean?       @default(false)
  orderDate               DateTime?      @default(now())
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  notifications           Notification[]
  orderItems              OrderItem[]
  branch                  Branch?        @relation(fields: [branchId], references: [id])
  patient                 Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pharmacy                Pharmacy       @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  prescription            Prescription?  @relation(fields: [prescriptionId], references: [id])
  payment                 Payment?

  @@index([patientId])
  @@index([pharmacyId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           String     @id @default(uuid())
  orderId      String
  medicationId String
  quantity     Int
  price        Float
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([medicationId])
  @@map("order_items")
}

model Payment {
  id                    String        @id @default(uuid())
  orderId               String        @unique
  amount                Decimal       @db.Decimal(12, 2)
  paymentMethod         PaymentMethod
  status                PaymentStatus @default(PENDING)
  transactionId         String?       @unique
  flutterwaveRef        String?       @unique
  receiptNumber         String?       @unique
  insuranceProvider     String?
  insurancePolicyNumber String?
  insuranceCoverage     Float?
  insuranceVerified     Boolean       @default(false)
  paymentResponse       Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  invoices              Invoice[]
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([transactionId])
  @@map("payments")
}

model HospitalPayment {
  id                String        @id @default(uuid())
  invoiceId         String
  patientId         String
  amount            Decimal       @db.Decimal(12, 2)
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  insuranceProvider String?
  insuranceClaimRef String?
  notes             String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  invoice           Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  patient           Patient       @relation(fields: [patientId], references: [id])

  @@index([invoiceId])
  @@map("hospital_payments")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String?
  patientId  String?
  pharmacyId String?
  orderId    String?
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  order      Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  patient    Patient?         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pharmacy   Pharmacy?        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([pharmacyId])
  @@index([orderId])
  @@index([isRead])
  @@map("notifications")
}

model Attendance {
  id                 String           @id @default(uuid())
  staffId            String
  branchId           String
  clockInTime        DateTime?
  clockInLocation    Json?
  clockInApproved    Boolean          @default(false)
  clockInApprovedAt  DateTime?
  clockInApprovedBy  String?
  clockOutTime       DateTime?
  clockOutLocation   Json?
  clockOutApproved   Boolean          @default(false)
  clockOutApprovedAt DateTime?
  clockOutApprovedBy String?
  status             AttendanceStatus @default(PENDING)
  totalHours         Float?
  notes              String?
  rejectionReason    String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  branch             Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  clockInApprover    Staff?           @relation("ClockInApprover", fields: [clockInApprovedBy], references: [id])
  clockOutApprover   Staff?           @relation("ClockOutApprover", fields: [clockOutApprovedBy], references: [id])
  staff              Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([branchId])
  @@index([clockInTime])
  @@index([status])
  @@map("attendance")
}

model StockTransfer {
  id              String              @id @default(uuid())
  fromBranchId    String
  toBranchId      String
  status          TransferStatus      @default(PENDING)
  rejectionReason String?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  items           StockTransferItem[]
  fromBranch      Branch              @relation("FromBranch", fields: [fromBranchId], references: [id], onDelete: Cascade)
  toBranch        Branch              @relation("ToBranch", fields: [toBranchId], references: [id], onDelete: Cascade)

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id           String        @id @default(uuid())
  transferId   String
  medicationId String
  quantity     Int
  createdAt    DateTime      @default(now())
  medication   Medication    @relation(fields: [medicationId], references: [id])
  transfer     StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([medicationId])
  @@map("stock_transfer_items")
}

model SupportTicket {
  id           String                @id @default(uuid())
  ticketNumber String                @unique
  name         String
  email        String
  phone        String?
  category     SupportTicketCategory
  message      String
  status       SupportTicketStatus   @default(OPEN)
  userId       String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  user         User?                 @relation(fields: [userId], references: [id])

  @@map("support_tickets")
}

enum UserRole {
  SUPER_ADMIN
  PHARMACY
  PATIENT
  BRANCH_MANAGER
  PHARMACIST
  CASHIER
  HOSPITAL_ADMIN
  DOCTOR
  RECEPTIONIST
  NURSE
}

enum PharmacyStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  OUT_FOR_DELIVERY
  READY_FOR_PICKUP
  DELIVERED
  COMPLETED
  CANCELLED
}

enum OrderType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  MTN_MOMO
  AIRTEL_MONEY
  CARD
  CASH
  INSURANCE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  ORDER_PLACED
  ORDER_ACCEPTED
  ORDER_PREPARING
  ORDER_OUT_FOR_DELIVERY
  ORDER_READY_FOR_PICKUP
  ORDER_DELIVERED
  ORDER_CANCELLED
  PRESCRIPTION_REJECTED
  PRESCRIPTION_APPROVED
  PHARMACY_APPROVED
  PHARMACY_REJECTED
  LOW_STOCK
}

enum PrescriptionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AIProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  SHIPPED
  COMPLETED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum BranchStatus {
  INVITED
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PENDING
  APPROVED
  CLOCKED_OUT
  COMPLETED
  REJECTED
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  VOID
}

enum SupportTicketCategory {
  order_issue
  billing
  technical
  account
  other
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}
