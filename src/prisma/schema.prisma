generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  password               String
  role                   UserRole
  isVerified             Boolean   @default(false)
  refreshToken           String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  verificationCode       String?
  verificationCodeExpiry DateTime?
  patient                Patient?
  pharmacy               Pharmacy?

  @@index([email])
  @@map("users")
}

model Patient {
  id                String         @id @default(uuid())
  userId            String         @unique
  firstName         String
  lastName          String
  phone             String
  dateOfBirth       DateTime?
  gender            String?
  address           String?
  insuranceProvider String?
  insurancePolicy   String?
  insuranceMemberId String?
  insuranceCoverage Int?           @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  cart_items        cart_items[]
  notifications     Notification[]
  orders            Order[]
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescriptions     Prescription[]

  @@index([userId])
  @@map("patients")
}

model Pharmacy {
  id                  String         @id @default(uuid())
  userId              String         @unique
  name                String
  phone               String
  address             String
  latitude            Float?
  longitude           Float?
  deliveryZones       Json?
  operatingHours      Json?
  status              PharmacyStatus @default(PENDING)
  rejectionReason     String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  approvedAt          DateTime?
  dateOfIncorporation DateTime
  pharmacyLicense     String
  rdbCertificate      String
  representativeName  String
  cart_items          cart_items[]
  medications         Medication[]
  notifications       Notification[]
  orders              Order[]
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("pharmacies")
}

model Medication {
  id                       String                     @id @default(uuid())
  pharmacyId               String
  name                     String
  description              String?
  category                 String
  price                    Float
  quantity                 Int
  lowStockThreshold        Int                        @default(10)
  requiresPrescription     Boolean                    @default(false)
  imageUrl                 String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  cart_items               cart_items[]
  pharmacy                 Pharmacy                   @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  orderItems               OrderItem[]
  prescription_medications prescription_medications[]

  @@index([pharmacyId])
  @@index([name])
  @@map("medications")
}

model Order {
  id                 String         @id @default(uuid())
  patientId          String
  pharmacyId         String
  orderNumber        String         @unique
  type               OrderType
  status             OrderStatus    @default(PENDING)
  deliveryAddress    String?
  deliveryFee        Float          @default(0)
  deliveryZone       String?
  prescriptionId     String?        @unique
  subtotal           Float
  total              Float
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus  @default(PENDING)
  insuranceCoverage  Float?
  patientPayment     Float
  cancellationReason String?
  cancelledAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  notifications      Notification[]
  orderItems         OrderItem[]
  patient            Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pharmacy           Pharmacy       @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  prescription       Prescription?  @relation(fields: [prescriptionId], references: [id])
  payment            Payment?

  @@index([patientId])
  @@index([pharmacyId])
  @@index([orderNumber])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           String     @id @default(uuid())
  orderId      String
  medicationId String
  quantity     Int
  price        Float
  createdAt    DateTime   @default(now())
  medication   Medication @relation(fields: [medicationId], references: [id])
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([medicationId])
  @@map("order_items")
}

model Prescription {
  id                       String                     @id @default(uuid())
  patientId                String
  fileUrl                  String
  fileName                 String
  fileType                 String
  status                   PrescriptionStatus         @default(PENDING)
  rejectionReason          String?
  reviewedAt               DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  aiProcessingError        String?
  aiProcessingStatus       AIProcessingStatus?        @default(PENDING)
  extractedMedications     Json?
  cart_items               cart_items[]
  order                    Order?
  prescription_medications prescription_medications[]
  patient                  Patient                    @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([status])
  @@map("prescriptions")
}

model Payment {
  id                    String        @id @default(uuid())
  orderId               String        @unique
  amount                Float
  paymentMethod         PaymentMethod
  status                PaymentStatus @default(PENDING)
  transactionId         String?       @unique
  flutterwaveRef        String?       @unique
  insuranceProvider     String?
  insurancePolicyNumber String?
  insuranceCoverage     Float?
  insuranceVerified     Boolean       @default(false)
  paymentResponse       Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([transactionId])
  @@map("payments")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String?
  patientId  String?
  pharmacyId String?
  orderId    String?
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  order      Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  patient    Patient?         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pharmacy   Pharmacy?        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([pharmacyId])
  @@index([orderId])
  @@index([isRead])
  @@map("notifications")
}

model cart_items {
  id             String        @id
  patientId      String
  pharmacyId     String
  medicationId   String
  quantity       Int           @default(1)
  prescriptionId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  medications    Medication    @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  patients       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pharmacies     Pharmacy      @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  prescriptions  Prescription? @relation(fields: [prescriptionId], references: [id])

  @@unique([patientId, medicationId])
  @@index([medicationId])
  @@index([patientId])
  @@index([pharmacyId])
}

model prescription_medications {
  id                  String       @id
  prescriptionId      String
  medicationName      String
  dosage              String?
  frequency           String?
  duration            String?
  quantity            Int          @default(1)
  matchedMedicationId String?
  available           Boolean      @default(false)
  createdAt           DateTime     @default(now())
  medications         Medication?  @relation(fields: [matchedMedicationId], references: [id])
  prescriptions       Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([matchedMedicationId])
  @@index([prescriptionId])
}

enum UserRole {
  SUPER_ADMIN
  PHARMACY
  PATIENT
}

enum PharmacyStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  OUT_FOR_DELIVERY
  READY_FOR_PICKUP
  DELIVERED
  COMPLETED
  CANCELLED
}

enum OrderType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  MTN_MOMO
  AIRTEL_MONEY
  CARD
  INSURANCE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  ORDER_PLACED
  ORDER_ACCEPTED
  ORDER_PREPARING
  ORDER_OUT_FOR_DELIVERY
  ORDER_READY_FOR_PICKUP
  ORDER_DELIVERED
  ORDER_CANCELLED
  PRESCRIPTION_REJECTED
  PHARMACY_APPROVED
  PHARMACY_REJECTED
  PRESCRIPTION_APPROVED
}

enum PrescriptionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AIProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
