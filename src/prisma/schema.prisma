model InsuranceClaim {
  id            String                @id @default(uuid())
  invoiceId     String                @unique
  provider      String
  claimAmount   Decimal               @db.Decimal(12, 2)
  settledAmount Decimal               @default(0) @db.Decimal(12, 2)
  difference    Decimal               @default(0) @db.Decimal(12, 2)
  status        ClaimStatus           @default(PENDING)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  invoice       HospitalInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  @@map("insurance_claims")
}
